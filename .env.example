# Create a unique password (12+ characters) and set it locally before the first launch.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password
# Optional local development account. Never set these in production.
DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=
DATA_DIR=./data
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
PORT=3001
# MongoDB Atlas is required in production; keep its URI in ignored .env only.
MONGODB_URI=
# Optional legacy PostgreSQL fallback for local development.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
# Public clone origin used when generating SEO canonicals and sitemap.xml.
SITE_ORIGIN=http://localhost:3000

# Razorpay Standard Checkout. Keep the secret values server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local-only override; works only with Razorpay test keys and NODE_ENV other than production.
COMMERCE_TEST_MODE=false

# Resend email delivery. Verify the sender domain before enabling mandatory email verification.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_VERIFICATION_REQUIRED=false
TOKEN_PEPPER=replace-with-a-random-32-byte-secret
